<?xml version="1.0" encoding="UTF-8"?>
<flowgorithm fileversion="2.11">
<attributes>
<attribute name="name" value="Calculadora Multifuncional"/>
<attribute name="authors" value="Roberto"/>
<attribute name="about" value="Trabalho de Tecnologia da Informacao - Calculadora Multifuncional com menu de 11 opcoes"/>
<attribute name="saved" value="2026-08-21 12:00:00"/>
<attribute name="created" value=""/>
<attribute name="edited" value=""/>
</attributes>
<function name="Main" type="None" variable="">
<parameters/>
<body>
<comment text="Calculadora Multifuncional - menu principal em loop até a opção 11 (Encerrar)."/><declare name="opcao" type="Integer" array="False" size=""/><declare name="n1,n2,n3,resultado" type="Real" array="False" size=""/><declare name="base,expoente" type="Real" array="False" size=""/><declare name="raio" type="Real" array="False" size=""/><declare name="baseRet,alturaRet" type="Real" array="False" size=""/><declare name="celsius" type="Real" array="False" size=""/><assign variable="opcao" expression="0"/><while expression="opcao&lt;&gt;11"><output expression="&quot;========================================&quot;" newline="True"/><output expression="&quot;        CALCULADORA MULTIFUNCIONAL&quot;" newline="True"/><output expression="&quot;========================================&quot;" newline="True"/><output expression="&quot;1  - Soma&quot;" newline="True"/><output expression="&quot;2  - Subtração&quot;" newline="True"/><output expression="&quot;3  - Multiplicação&quot;" newline="True"/><output expression="&quot;4  - Divisão&quot;" newline="True"/><output expression="&quot;5  - Potenciação&quot;" newline="True"/><output expression="&quot;6  - Raiz Quadrada&quot;" newline="True"/><output expression="&quot;7  - Área do Círculo&quot;" newline="True"/><output expression="&quot;8  - Área do Retângulo&quot;" newline="True"/><output expression="&quot;9  - Conversão de Celsius para Fahrenheit&quot;" newline="True"/><output expression="&quot;10 - Média Aritmética&quot;" newline="True"/><output expression="&quot;11 - Encerrar o Programa&quot;" newline="True"/><output expression="&quot;========================================&quot;" newline="True"/><output expression="&quot;Escolha uma opção (1 a 11): &quot;" newline="True"/><input variable="opcao"/><if expression="opcao=1"><then><output expression="&quot;--- Opção 1: Soma ---&quot;" newline="True"/><output expression="&quot;Digite o primeiro número:&quot;" newline="True"/><input variable="n1"/><output expression="&quot;Digite o segundo número:&quot;" newline="True"/><input variable="n2"/><assign variable="resultado" expression="n1+n2"/><output expression="&quot;Resultado: &quot; &amp; n1 &amp; &quot; + &quot; &amp; n2 &amp; &quot; = &quot; &amp; resultado" newline="True"/></then><else><if expression="opcao=2"><then><output expression="&quot;--- Opção 2: Subtração ---&quot;" newline="True"/><output expression="&quot;Digite o primeiro número:&quot;" newline="True"/><input variable="n1"/><output expression="&quot;Digite o segundo número:&quot;" newline="True"/><input variable="n2"/><assign variable="resultado" expression="n1-n2"/><output expression="&quot;Resultado: &quot; &amp; n1 &amp; &quot; - &quot; &amp; n2 &amp; &quot; = &quot; &amp; resultado" newline="True"/></then><else><if expression="opcao=3"><then><output expression="&quot;--- Opção 3: Multiplicação ---&quot;" newline="True"/><output expression="&quot;Digite o primeiro número:&quot;" newline="True"/><input variable="n1"/><output expression="&quot;Digite o segundo número:&quot;" newline="True"/><input variable="n2"/><assign variable="resultado" expression="n1*n2"/><output expression="&quot;Resultado: &quot; &amp; n1 &amp; &quot; * &quot; &amp; n2 &amp; &quot; = &quot; &amp; resultado" newline="True"/></then><else><if expression="opcao=4"><then><output expression="&quot;--- Opção 4: Divisão ---&quot;" newline="True"/><output expression="&quot;Digite o numerador:&quot;" newline="True"/><input variable="n1"/><output expression="&quot;Digite o denominador:&quot;" newline="True"/><input variable="n2"/><if expression="n2=0"><then><output expression="&quot;Erro: não é possível dividir por zero!&quot;" newline="True"/></then><else><assign variable="resultado" expression="n1/n2"/><output expression="&quot;Resultado: &quot; &amp; n1 &amp; &quot; / &quot; &amp; n2 &amp; &quot; = &quot; &amp; resultado" newline="True"/></else></if></then><else><if expression="opcao=5"><then><output expression="&quot;--- Opção 5: Potenciação ---&quot;" newline="True"/><output expression="&quot;Digite a base:&quot;" newline="True"/><input variable="base"/><output expression="&quot;Digite o expoente:&quot;" newline="True"/><input variable="expoente"/><assign variable="resultado" expression="base^expoente"/><output expression="&quot;Resultado: &quot; &amp; base &amp; &quot; ^ &quot; &amp; expoente &amp; &quot; = &quot; &amp; resultado" newline="True"/></then><else><if expression="opcao=6"><then><output expression="&quot;--- Opção 6: Raiz Quadrada ---&quot;" newline="True"/><output expression="&quot;Digite o número:&quot;" newline="True"/><input variable="n1"/><if expression="n1&lt;0"><then><output expression="&quot;Erro: não existe raiz quadrada real de número negativo!&quot;" newline="True"/></then><else><assign variable="resultado" expression="Sqrt(n1)"/><output expression="&quot;Resultado: raiz quadrada de &quot; &amp; n1 &amp; &quot; = &quot; &amp; resultado" newline="True"/></else></if></then><else><if expression="opcao=7"><then><output expression="&quot;--- Opção 7: Área do Círculo ---&quot;" newline="True"/><output expression="&quot;Digite o raio:&quot;" newline="True"/><input variable="raio"/><assign variable="resultado" expression="pi*(raio^2)"/><output expression="&quot;Resultado: área do círculo de raio &quot; &amp; raio &amp; &quot; = &quot; &amp; resultado" newline="True"/></then><else><if expression="opcao=8"><then><output expression="&quot;--- Opção 8: Área do Retângulo ---&quot;" newline="True"/><output expression="&quot;Digite a base do retângulo:&quot;" newline="True"/><input variable="baseRet"/><output expression="&quot;Digite a altura do retângulo:&quot;" newline="True"/><input variable="alturaRet"/><assign variable="resultado" expression="baseRet*alturaRet"/><output expression="&quot;Resultado: área do retângulo = &quot; &amp; resultado" newline="True"/></then><else><if expression="opcao=9"><then><output expression="&quot;--- Opção 9: Conversão Celsius para Fahrenheit ---&quot;" newline="True"/><output expression="&quot;Digite a temperatura em graus Celsius:&quot;" newline="True"/><input variable="celsius"/><assign variable="resultado" expression="(celsius*9/5)+32"/><output expression="&quot;Resultado: &quot; &amp; celsius &amp; &quot; C = &quot; &amp; resultado &amp; &quot; F&quot;" newline="True"/></then><else><if expression="opcao=10"><then><output expression="&quot;--- Opção 10: Média Aritmética ---&quot;" newline="True"/><output expression="&quot;Digite o primeiro número:&quot;" newline="True"/><input variable="n1"/><output expression="&quot;Digite o segundo número:&quot;" newline="True"/><input variable="n2"/><output expression="&quot;Digite o terceiro número:&quot;" newline="True"/><input variable="n3"/><assign variable="resultado" expression="(n1+n2+n3)/3"/><output expression="&quot;Resultado: a média de &quot; &amp; n1 &amp; &quot;, &quot; &amp; n2 &amp; &quot; e &quot; &amp; n3 &amp; &quot; é = &quot; &amp; resultado" newline="True"/></then><else><if expression="opcao=11"><then><output expression="&quot;Encerrando o programa. Até a próxima!&quot;" newline="True"/></then><else><output expression="&quot;Opção inválida! Digite um número entre 1 e 11.&quot;" newline="True"/></else></if></else></if></else></if></else></if></else></if></else></if></else></if></else></if></else></if></else></if></else></if></while><output expression="&quot;Programa encerrado.&quot;" newline="True"/>
</body>
</function>
</flowgorithm>
